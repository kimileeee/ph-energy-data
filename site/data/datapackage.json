{
  "name": "ph-electricity-rates",
  "title": "Philippine electricity rates per distribution utility (prototype)",
  "description": "DOE's hand-compiled monthly rate sheet as a tidy, joinable dataset, with a master list of distribution utilities keyed by a stable ID and PSGC codes, and automated checks against utilities' own rate documents.",
  "version": "0.1.0",
  "created": "2026-11-16T15:54:17+00:00",
  "licenses": [
    {
      "name": "ODC-BY-1.0",
      "path": "https://opendatacommons.org/licenses/by/1-0/",
      "title": "Open Data Commons Attribution License (compilation); source data remains under its publishers' terms"
    }
  ],
  "sources": [
    {
      "title": "DOE: Electricity rates per distribution utility (Google Sheet)",
      "path": "https://docs.google.com/spreadsheets/d/1oGc1iGpacELS6tkHjesvAeKZo8v2iv4UkYFY04e0p-I"
    },
    {
      "title": "DOE: Data and prices, electricity",
      "path": "https://www.doe.gov.ph/data-and-prices/electricity"
    },
    {
      "title": "PSA PSGC via github.com/bendlikeabamboo/barangay (MIT)",
      "path": "https://github.com/bendlikeabamboo/barangay"
    },
    {
      "title": "Wikipedia: List of electric distribution utilities in the Philippines",
      "path": "https://en.wikipedia.org/wiki/List_of_electric_distribution_utilities_in_the_Philippines"
    }
  ],
