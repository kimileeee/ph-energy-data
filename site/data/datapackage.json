    {
      "name": "rates",
      "path": "rates.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "description": "Monthly retail rate per customer class and blended generation charge, PHP/kWh, as DOE compiled them.",
      "schema": {
        "fields": [
          {
            "name": "utility_id",
            "type": "string",
            "description": "Stable slug ID, issued once from DOE's printed name and never reissued."
          },
          {
            "name": "month",
            "type": "string",
            "description": "YYYY-MM."
          },
          {
            "name": "customer_class",
            "type": "string"
          },
          {
            "name": "rate_php_per_kwh",
            "type": "number",
            "description": "Retail rate in PHP/kWh. Null where DOE has no data (see rate_note)."
          },
          {
            "name": "generation_charge",
            "type": "number",
            "description": "Blended generation charge in PHP/kWh for the utility-month (same on every class row)."
          },
          {
            "name": "rate_note",
            "type": "string",
            "description": "Empty for a clean number; NDA (DOE: no data available), blank, or unparsed:<cell>."
          },
          {
            "name": "generation_note",
            "type": "string"
          },
          {
            "name": "doe_source",
            "type": "string"
          }
        ],
        "primaryKey": [
          "utility_id",
          "month",
          "customer_class"
        ],
        "foreignKeys": [
